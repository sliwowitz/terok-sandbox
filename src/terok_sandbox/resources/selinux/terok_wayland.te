module terok_wayland 1.2;

# Optional domain for the Wayland supervisor child and the stock wl-mitm
# it runs.  The launcher asks for this domain when it execs the Python
# child; nothing is relabelled and nothing enters the domain on its own.
# The proxy's listening socket carries the domain's label, so a container
# can be allowed to reach the proxy without being allowed to reach the
# compositor, which stays unconfined_t.
#
# Experimental, and deliberately broad where breadth buys compatibility:
#
#   * The domain may read and run every file type.  Python and wl-mitm
#     start from wherever the operator installed them (distribution
#     packages, pipx, uv, pip --user, a checkout) without one rule per
#     layout.  Unix permissions still apply, and Landlock narrows the
#     proxy itself to its own runtime directory.
#   * It writes only the task's runtime directory and descriptors handed
#     to it.  No network, D-Bus, ptrace or device access is granted.
#
# What changes for every container on the host: container_t may connect
# to sockets of this domain, and may write and map user_tmp_t files it
# has been handed (compositor keymaps and buffers).  Nothing else.
#
# SELinux cannot tell the selected compositor from other unconfined_t
# sockets with the same user_tmp_t inode label, so the protocol filter
# and the immutable proxy configuration remain the boundary that matters.
#
# Install: sudo bash install_policy.sh --with-wayland
# Remove:  sudo semodule -r terok_wayland

require {
    attribute domain;
    attribute file_type;
    type unconfined_t, container_runtime_t, container_t, container_file_t;
    type user_tmp_t, tmpfs_t, security_t;
    role unconfined_r, system_r;
    class process { transition fork sigchld signal sigkill signull getattr getsched setrlimit siginh rlimitinh };
    class process2 { nnp_transition nosuid_transition };
    class dir { create open read search getattr write setattr add_name remove_name };
    class file { create entrypoint execute execute_no_trans read write append getattr open map };
    class lnk_file { read getattr };
    class sock_file { create unlink write getattr setattr };
    class unix_stream_socket { create bind listen accept connect connectto read write getattr getopt setopt shutdown };
    class fd use;
    class fifo_file { read write getattr };
    class security check_context;
}

type terok_wayland_t, domain;
role unconfined_r types terok_wayland_t;
role system_r types terok_wayland_t;

# 1. Entry.  Only the supervisor's own domains enter, and only by asking.
#    no_new_privs and nosuid mounts stay as the launcher set them.
allow { unconfined_t container_runtime_t } terok_wayland_t:process { transition siginh rlimitinh signal sigkill signull getattr };
allow { unconfined_t container_runtime_t } terok_wayland_t:process2 { nnp_transition nosuid_transition };
allow terok_wayland_t { unconfined_t container_runtime_t }:process sigchld;
allow terok_wayland_t { unconfined_t container_runtime_t }:fifo_file { read write getattr };

# 2. The domain's own processes, pipes and sockets.
allow terok_wayland_t self:process { fork sigchld signal getattr getsched setrlimit };
allow terok_wayland_t self:fifo_file { read write getattr };
allow terok_wayland_t self:unix_stream_socket { create bind listen accept connect read write getattr getopt setopt shutdown };

# 3. Read and run anything the invoking user may.  No write, no create.
allow terok_wayland_t file_type:dir { search getattr open read };
allow terok_wayland_t file_type:lnk_file { read getattr };
allow terok_wayland_t file_type:file { entrypoint execute execute_no_trans read getattr open map };

# 4. The child confirms its own domain before it execs the proxy.  That
#    query goes through selinuxfs and cannot change the loaded policy.
allow terok_wayland_t security_t:file { read write getattr open };
allow terok_wayland_t security_t:security check_context;

# 5. The listener in the task's runtime directory (container_file_t once
#    Podman has labelled it), and the compositor upstream of it.
allow terok_wayland_t container_file_t:dir { create write setattr add_name remove_name };
allow terok_wayland_t container_file_t:sock_file { create unlink write getattr setattr };
allow container_t terok_wayland_t:unix_stream_socket connectto;
allow terok_wayland_t user_tmp_t:sock_file { write getattr };
allow terok_wayland_t unconfined_t:unix_stream_socket connectto;

# 6. Descriptors passed through the proxy: shared memory, keymaps, render
#    buffers.  Owner and inode keep their labels; receiving a compositor's
#    read-write buffer must work even for a client that only maps it.
#    DMA-buf and syncobj exports are anonymous inodes that fd use covers,
#    so no GPU device can be opened from here.
allow terok_wayland_t { unconfined_t container_runtime_t container_t }:fd use;
allow terok_wayland_t { container_file_t user_tmp_t tmpfs_t }:file { write append create };
allow container_t user_tmp_t:file { write map };

# A policy that enables the memfd class labels memfds with their creator's
# domain; policies without the class use the tmpfs rules above.
optional {
    require {
        class memfd_file { create read write getattr open map };
    }
    allow terok_wayland_t self:memfd_file { create read write getattr open map };
    allow terok_wayland_t { unconfined_t container_runtime_t container_t }:memfd_file { read write getattr open map };
    allow container_t unconfined_t:memfd_file { read write getattr map };
}
